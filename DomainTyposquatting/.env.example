# ============================================================
#  Domain Typosquatting Platform - Environment Configuration
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
# Local: runs in Docker alongside the app
# Azure: swap for Azure Database for PostgreSQL Flexible Server connection string
POSTGRES_DB=typosquatting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/typosquatting

# ── pgAdmin (Local Debug UI) ────────────────────────────────
# Browse tables at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ── Orchestrator API (Port 8001) ─────────────────────────────
# URL of the dnstwist scanning engine
DNSTWIST_API_URL=http://dnstwist-api:8000
# URL of who-dat WHOIS/RDAP lookup service
WHO_DAT_URL=http://who-dat:8080

# ── WhoisDS NRD API (Port 8002) ─────────────────────────────
# Credentials for auto-downloading NRD files from WhoisDS
# Leave blank to disable auto-download (manually place files in InstalledNRD/)
WHOISDS_EMAIL=
WHOISDS_PASSWORD=
# URL of orchestrator for pass_to_dnstwist feature
ORCHESTRATOR_URL=http://orchestrator-api:8001

# ── Who-Dat WHOIS API (Port 8080) ────────────────────────────
# Built from local source (Go app with WHOIS + RDAP fallback)
