# ============================================================
#  Domain Typosquatting Platform - Environment Configuration
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
# Local: runs in Docker alongside the app
# Azure: swap for Azure Database for PostgreSQL Flexible Server connection string
POSTGRES_DB=typosquatting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/typosquatting

# ── pgAdmin (Local Debug UI) ────────────────────────────────
# Browse tables at http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ── DNSTwist API (Port 8000) ─────────────────────────────────
# API key required to call /scan endpoints
DNSTWIST_API_KEY=changeme

# ── Callback Configuration ───────────────────────────────────
# Where dnstwist-api sends async scan results
# (auto-set to orchestrator in docker-compose, override if needed)
CALLBACK_URL=http://orchestrator-api:8001/api/callback
CALLBACK_METHOD=POST

# Callback Authentication (choose ONE, leave others blank)
# Option 1: API Key
CALLBACK_API_KEY=
CALLBACK_API_KEY_HEADER=X-API-Key

# Option 2: Bearer Token
CALLBACK_BEARER_TOKEN=

# Option 3: Basic Auth
CALLBACK_BASIC_USER=
CALLBACK_BASIC_PASS=

# Option 4: Custom Header
CALLBACK_CUSTOM_HEADER=
CALLBACK_CUSTOM_VALUE=

# ── Orchestrator API (Port 8001) ─────────────────────────────
# URL of the dnstwist scanning engine
DNSTWIST_API_URL=http://dnstwist-api:8000
# URL of who-dat WHOIS/RDAP lookup service
WHO_DAT_URL=http://who-dat:8080

# ── WhoisDS NRD API (Port 8002) ──────────────────────────────
# Orchestrator URL for pushing matched domains
ORCHESTRATOR_URL=http://orchestrator-api:8001

# ── Who-Dat WHOIS API (Port 8080) ────────────────────────────
# Pre-built image: lissy93/who-dat (no extra config needed)
